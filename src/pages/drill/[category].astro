---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { FreeDrill } from '../../components/games/FreeDrill';
import { generatorsBySubgroup } from '../../lib/generators/registry';
import { CATEGORY_DESCRIPTIONS, type Category } from '../../lib/types';

// Defined inline: Astro binds getStaticPaths to the page module, so a re-export
// from a helper would break route generation. Astro also hoists this function
// above the rest of the frontmatter, so it must not close over module-scope
// constants — every value it needs is defined inside it.
export function getStaticPaths() {
  return [
    { slug: 'math', label: 'Math' },
    { slug: 'markets', label: 'Markets' },
    { slug: 'derivatives', label: 'Asia Derivatives' },
  ].map(({ slug, label }) => ({
    params: { category: slug },
    props: { category: slug as Category, label },
  }));
}

const { category, label } = Astro.props as { category: Category; label: string };

// Sub-grouped so the merged derivatives category still shows listed contracts,
// OTC exotics and the vol surface as separate topics.
const groups = generatorsBySubgroup(category);
const total = groups.reduce((n, g) => n + g.generators.length, 0);
const base = import.meta.env.BASE_URL;
---

<StarlightPage frontmatter={{ title: `${label} quiz`, description: `Unlimited ${label} practice.` }}>
  <p>{CATEGORY_DESCRIPTIONS[category]}</p>

  {/* The quiz comes first: this is a quiz site, and the material below supports it. */}
  <FreeDrill client:load category={category} />

  <details style="margin-top: 2rem">
    <summary style="cursor: pointer">
      What this pool tests ({total} generators)
    </summary>
    {groups.map((group) => (
      <div style="margin-top: 1rem">
        <h3 style="margin-bottom: 0.25rem">{group.label}</h3>
        <ul>
          {group.generators.map((generator) => (
            <li>
              <span class="tt-mono">{generator.id}</span> — {generator.about}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </details>

  <p class="tt-citation" style="margin-top: 1.5rem">
    Untimed and unlimited: this is the mode for working on one group rather than for measuring
    yourself. Nothing here affects your daily record, but anything you miss still feeds the
    spaced-repetition queue. For the mixed set, play <a href={base}>Today</a>.
  </p>

  {category === 'markets' ? (
    <p class="tt-citation">
      The market-structure reference pages are in the <strong>Content</strong> section of the
      sidebar, and each one links back here.
    </p>
  ) : null}
</StarlightPage>

