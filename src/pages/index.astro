---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { DailyChallenge } from '../components/games/DailyChallenge';
import { quizDateKey } from '../lib/seed';
import { populatedQuizzes } from '../lib/generators/registry';
import { url } from '../lib/url';
import { CATEGORY_LABELS, GROUP_SLUGS } from '../lib/types';

const dateKey = quizDateKey();
// Grouped so the index mirrors the sidebar.
const groups = (['math', 'markets', 'derivatives'] as const).map((category) => ({
  category,
  label: CATEGORY_LABELS[category],
  href: url(`group/${GROUP_SLUGS[category]}`),
  quizzes: populatedQuizzes().filter((q) => q.category === category),
}));
---

<StarlightPage frontmatter={{ title: 'Today', description: 'The daily set, and every quiz.' }}>
  <p>
    Twenty questions drawn from all three groups — <strong>Math</strong>, <strong>Markets</strong> and
    <strong>Asia Derivatives</strong> — interleaved rather than blocked, because that is what a trading
    day looks like. The set is generated from today's date, so every visitor gets the same questions
    today and your score is comparable from one day to the next.
  </p>
  <p class="tt-citation">
    Date key <span class="tt-mono">{dateKey}</span>, in Singapore time. The set rolls over at
    midnight SGT so the change happens at one unambiguous moment wherever you are.
  </p>

  <DailyChallenge client:load mode="drill" />

  <h2>Every quiz</h2>
  <p class="tt-citation">
    The daily set above mixes all of them. To drill a single quiz, pick one below or use the sidebar.
  </p>
  {groups.map((group) => (
    <div>
      <h3 style="margin-bottom: 0.25rem">
        <a href={group.href}>{group.label}</a>
      </h3>
      <ul>
        {group.quizzes.map((quiz) => (
          <li>
            <a href={url(`quiz/${quiz.subgroup}`)}>{quiz.label}</a>
          </li>
        ))}
      </ul>
    </div>
  ))}

  <p class="tt-citation">
    No account is needed and nothing is sent anywhere. Progress, personal bests and the
    spaced-repetition queue are stored in this browser only. See the About page to back up your
    progress.
  </p>
</StarlightPage>
