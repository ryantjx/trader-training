---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { CATEGORIES, CATEGORY_LABELS, GROUP_SLUGS, type Category } from '../lib/types';
import { DAILY_SET_SIZE, DAILY_QUOTA } from '../lib/daily';
import { quizDateKey } from '../lib/seed';
import { DAILY_SECONDS_PER_QUESTION } from '../lib/modes';
import { GROUP_GUIDES, QUIZ_GUIDES, groupMinutes } from '../lib/quiz-guides';
import { populatedQuizzes } from '../lib/generators/registry';
import { url } from '../lib/url';

// The homepage now answers "what is this, who is it for, what do I do next"
// before anything is timed. The daily set lives at /today.
const dateKey = quizDateKey();

const groups = (['math', 'markets', 'derivatives'] as const).map((category: Category) => ({
  category,
  label: CATEGORY_LABELS[category],
  href: url(`group/${GROUP_SLUGS[category]}`),
  guide: GROUP_GUIDES[category],
  minutes: groupMinutes(category),
  quizzes: populatedQuizzes()
    .filter((q) => q.category === category)
    .map((quiz) => ({ ...quiz, guide: QUIZ_GUIDES[quiz.subgroup] })),
}));

const totalMinutes = groups.reduce((sum, g) => sum + g.minutes, 0);
---

<StarlightPage
  frontmatter={{
    title: 'About',
    description:
      'Daily drills in the mental arithmetic, market structure and exotic payoffs an Asian derivatives desk uses.',
  }}
>
  <section>
    <h2>What this is</h2>
    <p>
      A training site for the Asian exotic-options desk. Three things get rusty fastest and are
      hardest to fake, so they are drilled: the arithmetic a trader does in their head, the market
      rules that decide what a trade costs, and the payoffs and conventions the book is priced on.
    </p>
    <p>
      It assumes you already know what a knock-in is. What it checks is whether you can size the
      hedge, quote the strike and name the fixing without looking it up. Every answer states the
      method, the rule of thumb and the source, so a miss is a lesson rather than a score.
    </p>
    <p>
      <strong>Twenty questions, about ten minutes, no calculator.</strong> If a term is unfamiliar,
      the <a href={url('manual/glossary')}>glossary</a> covers every abbreviation the questions use.
    </p>
    <p>
      <a href={url('today')}><strong>Start with today's set</strong></a> — or read the group briefs
      below and pick the quiz that matches what you want to work on.
    </p>
  </section>

  <h2>How the daily set is built</h2>
  <ul>
    <li>
      <strong>{DAILY_SET_SIZE} questions</strong>, mixed across the three groups rather than blocked,
      because that is what a trading day looks like: arithmetic and recall interleaved, with no
      warm-up.
    </li>
    <li>
      <strong>Generated from today's date.</strong> The whole set is a pure function of the date, so
      every visitor sees the same questions today and the set cannot go stale mid-day.
    </li>
    <li>
      <strong>Quota per group.</strong>{' '}
      {CATEGORIES.map((c) => `${CATEGORY_LABELS[c]} ${DAILY_QUOTA[c]}`).join(', ')}. Arithmetic and
      the derivatives layer each carry more than market recall, because those are the two skills the
      desk is judged on.
    </li>
    <li>
      <strong>Every answer comes with the method.</strong> Feedback gives the correct value, the
      reasoning, a rule of thumb to memorise, and the source. A right answer reached the wrong way is
      still worth correcting, so the explanation is shown either way.
    </li>
  </ul>

  <h2>How a session behaves</h2>
  <p>
    The daily set runs on a fixed budget: <strong>{DAILY_SECONDS_PER_QUESTION} seconds per
    question</strong>. The clock stops the moment you answer, so reading the explanation is never
    counted against you, and an unanswered question is recorded as a miss rather than skipped. There
    is no mode selector, so the questions mean the same thing today as they did last week.
  </p>
  <p>
    The single-quiz drills are deliberately different: untimed, unlimited, and scored only within the
    session. They exist for working on one thing rather than for measuring yourself.
  </p>

  <h2>What each group is for</h2>
  {groups.map((group) => (
    <section>
      <h3>
        <a href={group.href}>{group.label}</a>
        <span class="tt-citation"> — {group.minutes} min across {group.quizzes.length} quizzes</span>
      </h3>
      <p>{group.guide.purpose}</p>
      <p class="tt-note">
        <strong>Why a desk cares.</strong> {group.guide.whyItMatters}
      </p>
      <p class="tt-citation">
        A pass through this group should leave you able to: {group.guide.outcome}{' '}
        <a href={url(group.guide.manualPath)}>Read the background</a>.
      </p>

      <table>
        <thead>
          <tr>
            <th style="text-align: left; padding-right: 1.5rem">Quiz</th>
            <th style="text-align: left">Time</th>
          </tr>
        </thead>
        <tbody>
          {group.quizzes.map((quiz) => (
            <tr>
              <td style="text-align: left; padding-right: 1.5rem">
                <a href={url(`quiz/${quiz.subgroup}`)}>{quiz.label}</a>
              </td>
              <td style="text-align: left" class="tt-mono">{quiz.guide.minutes} min</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  ))}

  <p class="tt-citation">
    {totalMinutes} minutes to work through every quiz once, ignoring the daily set.
  </p>

  <h2>Reading</h2>
  <p>
    Every quiz links to the manual section that explains its reasoning, and the manual links back to
    the drills. Use them in either order — read then drill if the topic is new, drill then read if it
    is something you once knew.
  </p>
  <ul>
    <li><a href={url('manual')}>Start here</a> — what the manual covers and how it pairs with the drills.</li>
    <li><a href={url('manual/math')}>Math and units</a> — the conventions that make everything else safe.</li>
    <li><a href={url('manual/markets')}>Markets and microstructure</a> — sessions, clearing, costs, calendars.</li>
    <li><a href={url('manual/listed')}>Listed derivatives</a> — contract specifications and offshore access.</li>
    <li><a href={url('manual/exotics')}>Exotic options</a> — payoffs, surface conventions, the hedge gap.</li>
    <li><a href={url('manual/glossary')}>Glossary</a> — every abbreviation, defined.</li>
  </ul>

  <h2>Market reference</h2>
  <p>
    The <a href={url('reference')}>exchange overview</a> puts all four venues on one SGT clock, with
    the pairwise session overlaps and the auctions side by side. Per-venue pages carry the full rules
    and a note on what each venue can hedge.
  </p>
  <p class="tt-citation">
    <a href={url('reference/sgx')}>SGX</a> · <a href={url('reference/hkex')}>HKEX</a> ·{' '}
    <a href={url('reference/jpx')}>JPX</a> · <a href={url('reference/asx')}>ASX</a>. Data snapshot{' '}
    <span class="tt-mono">2026-10-17</span>; today's set key{' '}
    <span class="tt-mono">{dateKey}</span>.
  </p>
</StarlightPage>
