---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Term from '../../components/Term.astro';
import {
  SESSIONS,
  formatSessions,
  localToSgt,
  venueById,
  type Venue,
} from '../../lib/sessions';
import { VENUE_NOTES } from '../../lib/venue-notes';
import { url } from '../../lib/url';

// Defined inline: Astro binds getStaticPaths to the page module, so a re-export
// from a helper module would break route generation. Note also that Astro hoists
// this function above the rest of the frontmatter, so it must not close over
// module-scope constant — every value it needs is defined inside it.
export function getStaticPaths() {
  const titles: Record<string, string> = {
    sgx: 'SGX',
    hkex: 'HKEX',
    jpx: 'JPX',
    asx: 'ASX',
  };
  return SESSIONS.venues.map((venue: Venue) => ({
    params: { market: venue.id },
    props: {
      id: venue.id,
      title: titles[venue.id] ?? venue.name,
      dstCaveat: venue.dstNote && venue.dstNote.includes('UNVERIFIED') ? venue.dstNote : null,
    },
  }));
}

const { id, title, dstCaveat } = Astro.props as {
  id: string;
  title: string;
  dstCaveat: string | null;
};

const venue = venueById(id) as Venue;
const sessions = formatSessions(venue.continuousSgt);
const localSessions = formatSessions(venue.continuousLocal);
const lunch = venue.lunchSgt.map((s) => `${s.open}–${s.close}`).join(', ');
const marketsQuiz = url('group/2-markets');
const note = VENUE_NOTES[venue.id];
const manualMarkets = url('manual/markets');
const overview = url('reference');

// The data carries both clocks, so the offset can be checked rather than trusted.
const offsetLabel =
  venue.utcOffset === 8
    ? 'The local clock is the same as SGT'
    : `The local clock is ${Math.abs(venue.utcOffset - 8)} hour${Math.abs(venue.utcOffset - 8) === 1 ? '' : 's'} ahead of SGT`;
const firstLocal = venue.continuousLocal[0];
const firstSgt = venue.continuousSgt[0];
const derived = firstLocal ? localToSgt(venue, firstLocal.open) : null;
---

<StarlightPage
  frontmatter={{
    title: `${title} market structure`,
    description: `One-page market-structure summary for ${title}.`,
  }}
>
  <p class="tt-citation">
    Reference content, not a quiz. Part of the <a href={overview}>exchange overview</a>, and supports
    the <a href={marketsQuiz}>Markets quiz</a> where microstructure is tested.
  </p>

  {dstCaveat ? (
    <p class="tt-stale">
      <strong>Unverified.</strong> {dstCaveat}
    </p>
  ) : null}

  <table>
    <tbody>
      <tr><th style="text-align: left; padding-right: 1.5rem">Venue</th><td>{venue.name} ({venue.market})</td></tr>
      <tr>
        <th style="text-align: left; padding-right: 1.5rem">Trading hours (SGT)</th>
        <td class="tt-mono">{sessions}</td>
      </tr>
      <tr>
        <th style="text-align: left; padding-right: 1.5rem">Trading hours ({venue.timezone})</th>
        <td class="tt-mono">{localSessions}</td>
      </tr>
      <tr><th style="text-align: left; padding-right: 1.5rem">Offset</th><td class="tt-mono">{offsetLabel}</td></tr>
      {lunch ? <tr><th style="text-align: left; padding-right: 1.5rem">Lunch break</th><td class="tt-mono">{lunch}</td></tr> : null}
      <tr>
        <th style="text-align: left; padding-right: 1.5rem">Market close (SGT)</th>
        <td class="tt-mono">{venue.marketCloseSgt} SGT</td>
      </tr>
      <tr>
        <th style="text-align: left; padding-right: 1.5rem">Market close ({venue.timezone})</th>
        <td class="tt-mono">{venue.marketCloseLocal} {venue.timezone}</td>
      </tr>
      <tr><th style="text-align: left; padding-right: 1.5rem">Settlement</th><td>{venue.settlement}, <Term id="dvp" label={venue.settlementMethod} /></td></tr>
      <tr><th style="text-align: left; padding-right: 1.5rem">Clearing</th><td>{venue.clearingHouse}</td></tr>
      <tr><th style="text-align: left; padding-right: 1.5rem">Depository</th><td>{venue.depository}</td></tr>
      <tr>
        <th style="text-align: left; padding-right: 1.5rem">Scripless</th>
        <td>{venue.scripless ? 'Yes, book-entry only' : 'No, physical certificates are still permitted'}</td>
      </tr>
      <tr><th style="text-align: left; padding-right: 1.5rem">Stamp duty</th><td>{venue.stampDuty}</td></tr>
    </tbody>
  </table>

  <h2>Sessions and auctions</h2>

  {venue.preOpenSgt ? (
    <p>
      <strong>Pre-open.</strong> {venue.preOpenSgt.start} to {venue.preOpenSgt.end}
      {venue.preOpenSgt.randomEnd ? `, ending at a random point within ${venue.preOpenSgt.randomEnd}` : ''}.{' '}
      {venue.preOpenSgt.note}
    </p>
  ) : null}

  {venue.auctionsSgt.length > 0 ? (
    <>
      <p><strong>Auctions.</strong></p>
      <ul>
        {venue.auctionsSgt.map((a) => (
          <li><span class="tt-mono">{a.time}</span> — {a.name}</li>
        ))}
      </ul>
    </>
  ) : null}

  {venue.tradeAtCloseSgt ? (
    <p>
      <strong><Term id="tac" label="Trade at Close" /></strong>{' '}
      <span class="tt-mono">{venue.tradeAtCloseSgt} SGT</span>, trading at the fixed closing price. This
      window exists so a large order can be worked at a known price instead of taking closing-auction
      risk.
    </p>
  ) : null}

  {venue.nonCancelSgt.length > 0 ? (
    <>
      <p>
        <strong>Non-cancel phases.</strong> No order entry, modification or cancellation in these
        windows, so the auction price cannot be influenced once the phase has opened.
      </p>
      <ul>
        {venue.nonCancelSgt.map((n) => (
          <li><span class="tt-mono">{n}</span></li>
        ))}
      </ul>
    </>
  ) : null}

  <h2>What this means for hedging</h2>
  {note ? (
    <>
      <p>{note.headline}</p>
      <ul>
        {note.points.map((point) => (
          <li>
            <strong>{point.label}.</strong> {point.detail}
          </li>
        ))}
      </ul>
      <p>
        <strong>For a derivatives book.</strong> {note.hedging}
      </p>
    </>
  ) : (
    <p>
      The session window determines when a barrier or a fixing can be observed and when a hedge can
      be adjusted. Where the fixing source is not the instrument being hedged, the position carries a
      basis risk that no single-venue model will show.
    </p>
  )}

  <h2>Data confidence</h2>
  <p class="tt-citation">
    Snapshot <span class="tt-mono">{SESSIONS.asOf}</span>, displayed in {SESSIONS.displayTimezone}.
    Both clocks are carried in the data: the {venue.timezone} times come from the exchange rulebook and
    the SGT times are the same session on the desk clock. The offset check agrees — {firstLocal?.open}{' '}
    {venue.timezone} is {derived} SGT, which matches the stated {firstSgt?.open} SGT open.
  </p>
  <p class="tt-citation">
    {dstCaveat
      ? 'This venue carries an explicit unverified flag, shown above, and the drills exclude it where the flag would change the answer.'
      : 'No daylight-saving caveat applies to this venue, so its SGT times are unambiguous year-round.'}
  </p>

  <p>
    <strong>Practise this.</strong> The <a href={marketsQuiz}>Markets quiz</a> tests session times,
    clearing and stamp duty across the venues, drawn from this dataset so the quiz and this page
    cannot disagree. The reasoning behind the rules is in
    <a href={manualMarkets}>Markets and microstructure</a>.
  </p>

  <p class="tt-citation">
    Source: <span class="tt-mono">src/data/sessions.json</span>, derived from{' '}
    <span class="tt-mono">src/content/asia-market-structure.md</span> and the exchange rulebooks it
    cites. Verify against the exchange before relying on any figure here.
  </p>
</StarlightPage>
